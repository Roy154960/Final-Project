# Per-machine env vars
.env

# Per-machine MCP/OpenCode configs -- contain your local absolute path
# (and, for OpenCode, your Windows username), same "per-machine, don't
# commit" reasoning as .env above. agents/mcp_config.example.json and
# agents/opencode.example.json are the generic, placeholder-path
# templates that ARE meant to be committed -- only these two real,
# personal-path files are excluded.
.mcp.json
opencode.json

# Byte-compiled / cache
__pycache__/
*.pyc

# Groq usage/cost/trace logs (local_rag/usage_tracker.py) -- dev-only,
# per-machine, and can contain per-thread/per-question metadata that
# should not end up in version control. (local_rag/.gitignore also
# covers this from inside that folder -- kept here too since a
# per-directory .gitignore only applies to that directory and below.)
local_rag/logs/

documents/*.pdf
documents/*.txt