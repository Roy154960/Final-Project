# Copy this file to .env (same directory as docker-compose.yml) and adjust
# as needed, then run: docker compose up --build
#
# Every one of these has a working default already baked into
# docker-compose.yml -- you only need a .env at all if you want to change
# one of them (e.g. GEMINI_API_KEY for the online VLM backend, or the
# published ports if something else on your machine already uses 8001/
# 8080/8765/8000).

# ---------------------------------------------------------------------
# Ollama -- must be running on your HOST machine (`ollama serve`, same as
# your non-Docker workflow), not inside a container. Docker Desktop
# (Windows/Mac) resolves host.docker.internal to the host automatically;
# docker-compose.yml also adds the Linux equivalent
# (extra_hosts: host-gateway) so this same value works there too. If it
# still doesn't resolve on your setup, replace it with your host
# machine's actual LAN/bridge IP.
OLLAMA_HOST=http://host.docker.internal:11434

# ---------------------------------------------------------------------
# Optional: only needed if you want personal_rag's single-image uploads
# to use the online Gemini VLM backend (config.py's
# PERSONAL_RAG_SINGLE_IMAGE_VLM_BACKEND). Leave blank to fall back to the
# local Ollama VLM automatically -- see config.py's own docstring.
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Published host ports -- change any of these if it collides with
# something already running on your machine. Left-hand side is the port
# on YOUR machine; the containers always listen on their own fixed
# right-hand-side port regardless of what you set here.
BACKEND_PORT=8001
FRONTEND_PORT=8080
MCP_SERVER_PORT=8765
CHROMA_SERVER_PORT=8000

# ---------------------------------------------------------------------
# CORS origins the backend will accept requests from. Must include
# wherever the frontend is actually reachable in your browser -- update
# this if you change FRONTEND_PORT above.
AGENT_API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
